# ==============================================================================
# Git Ignore Configuration for Excel Report Intelligent Generation System
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 敏感配置与密钥 (API Keys & Secrets)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!*.env.example
secrets/
*.pem
*.key

# ------------------------------------------------------------------------------
# 2. Python 运行与构建缓存 (Python & Bytecode)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# 虚拟环境 (Virtual Environments)
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. 运行产生的数据湖、临时上传与导出物 (Databases & Runtime Data)
# ------------------------------------------------------------------------------
# SQLite 溯源湖与 DuckDB 缓存及 WAL 临时文件
*.db
*.db*
*.sqlite
*.sqlite3
*.duckdb
*.duckdb*
*.wal
*-wal
*-shm
*-journal
backend/data/*.db*
backend/data/*.duckdb*
backend/data/*.wal

# 动态上传的文件（保留 .gitkeep）
backend/data/uploads/*
!backend/data/uploads/.gitkeep

# 导出的 Word 报告与 Excel 对账表（保留 .gitkeep）
backend/data/exports/*
!backend/data/exports/.gitkeep

# 动态生成的统计图表图片（保留 .gitkeep）
backend/static/charts/*
!backend/static/charts/.gitkeep

# ------------------------------------------------------------------------------
# 4. 前端依赖与产物 (Vue 3 / Node.js)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/dist-ssr/
*.local

# 日志文件
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Pi-Agent 基座内部构建缓存 (Pi-Agent Internal Caches)
# ------------------------------------------------------------------------------
pi-main/node_modules/
pi-main/**/node_modules/
pi-main/**/dist/
pi-main/.pi/
pi-main/.artifacts/

# ------------------------------------------------------------------------------
# 6. 编辑器与操作系统专属文件 (IDE & OS)
# ------------------------------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
