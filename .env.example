# ==============================================================================
# Excel Report Intelligent System - Environment Configuration Example
# 复制本文件为 .env 并填入实际值 (注意：切勿将真实 API Key 提交到 GitHub)
# ==============================================================================

# DeepSeek 线上模型服务配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Jev 判别 / Judge 模型
JUDGE_MODEL=deepseek-chat

# 浏览器访问地址（多个地址用英文逗号分隔；部署时填写实际域名及端口）
APP_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
